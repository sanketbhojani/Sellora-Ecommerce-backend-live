<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Reset Password - Sellora</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      background-color: #0d0d0d;
      padding: 30px 15px;
    }

    .wrapper {
      max-width: 600px;
      margin: 0 auto;
      background-color: #1a1a2e;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 40px rgba(156, 39, 176, 0.15), 0 2px 10px rgba(0,0,0,0.6);
    }

    /* ── Header ── */
    .header {
      background: linear-gradient(135deg, #9c27b0 0%, #7b1fa2 40%, #FF6B35 100%);
      padding: 40px 30px 35px;
      text-align: center;
      position: relative;
    }

    .header::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #FF6B35, #9c27b0, #FF6B35);
    }

    .logo-img {
      width: 160px;
      height: auto;
      margin-bottom: 12px;
      border-radius: 8px;
    }

    .header-tagline {
      color: rgba(255,255,255,0.9);
      font-size: 13px;
      letter-spacing: 3px;
      text-transform: uppercase;
      font-weight: 500;
    }

    /* ── Shield Icon Section ── */
    .shield-section {
      text-align: center;
      padding: 30px 30px 0;
    }

    .shield-icon {
      display: inline-block;
      width: 70px;
      height: 70px;
      background: linear-gradient(135deg, rgba(156,39,176,0.2), rgba(255,107,53,0.15));
      border: 2px solid rgba(156,39,176,0.3);
      border-radius: 50%;
      line-height: 70px;
      font-size: 32px;
      margin-bottom: 10px;
    }

    .shield-title {
      font-size: 18px;
      color: #FF6B35;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* ── Body ── */
    .body {
      padding: 30px 35px 40px;
    }

    .greeting {
      font-size: 22px;
      color: #ffffff;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .greeting span {
      color: #FF6B35;
    }

    .sub-text {
      font-size: 15px;
      color: #a0a0b8;
      line-height: 1.8;
      margin-bottom: 32px;
    }

    .sub-text strong {
      color: #e0e0e0;
    }

    .sub-text .role-badge {
      display: inline-block;
      background: linear-gradient(135deg, #9c27b0, #7b1fa2);
      color: #ffffff;
      padding: 3px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      vertical-align: middle;
    }

    /* ── OTP Container ── */
    .otp-container {
      background: linear-gradient(145deg, #16162a, #1e1e3a);
      border: 1px solid rgba(156, 39, 176, 0.3);
      border-radius: 16px;
      padding: 30px 20px;
      text-align: center;
      margin-bottom: 30px;
      position: relative;
      overflow: hidden;
    }

    .otp-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, #9c27b0, #FF6B35);
    }

    .otp-label {
      font-size: 11px;
      color: #8888aa;
      text-transform: uppercase;
      letter-spacing: 3px;
      margin-bottom: 16px;
      font-weight: 600;
    }

    .otp-digits {
      display: inline-block;
      margin-bottom: 16px;
    }

    .otp-digits table {
      border-collapse: separate;
      border-spacing: 8px 0;
      margin: 0 auto;
    }

    .otp-digit {
      width: 52px;
      height: 62px;
      background: linear-gradient(180deg, #252545, #1a1a35);
      border: 2px solid #FF6B35;
      border-radius: 12px;
      font-size: 28px;
      font-weight: 800;
      color: #9c27b0;
      text-align: center;
      vertical-align: middle;
      letter-spacing: 0;
      font-family: 'Courier New', monospace;
    }

    .otp-expiry {
      font-size: 13px;
      color: #7a7a9a;
    }

    .otp-expiry strong {
      color: #FF6B35;
    }

    /* ── Security Warning ── */
    .security-box {
      background: linear-gradient(135deg, #1a1520, #201828);
      border: 1px solid rgba(255, 107, 53, 0.2);
      border-left: 4px solid #f44336;
      border-radius: 0 10px 10px 0;
      padding: 18px 22px;
      margin-bottom: 30px;
    }

    .security-box .security-title {
      font-size: 13px;
      font-weight: 700;
      color: #f44336;
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .security-box p {
      font-size: 13px;
      color: #b0b0c8;
      line-height: 1.7;
    }

    .security-box strong {
      color: #e0e0e0;
    }

    /* ── Steps Section ── */
    .steps {
      margin-bottom: 10px;
    }

    .steps-title {
      font-size: 16px;
      color: #ffffff;
      font-weight: 700;
      margin-bottom: 18px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(156, 39, 176, 0.2);
    }

    .step-row {
      margin-bottom: 14px;
    }

    .step-row table {
      width: 100%;
    }

    .step-number-cell {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, #9c27b0, #FF6B35);
      border-radius: 50%;
      text-align: center;
      vertical-align: middle;
      font-size: 14px;
      font-weight: 800;
      color: #ffffff;
    }

    .step-text-cell {
      padding-left: 14px;
      font-size: 14px;
      color: #c0c0d8;
      vertical-align: middle;
      line-height: 1.5;
    }

    /* ── Footer ── */
    .footer {
      background: linear-gradient(180deg, #111122, #0d0d1a);
      border-top: 1px solid rgba(156, 39, 176, 0.15);
      padding: 28px 30px;
      text-align: center;
    }

    .footer-brand {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .footer-brand .purple { color: #9c27b0; }
    .footer-brand .orange { color: #FF6B35; }

    .footer p {
      font-size: 11px;
      color: #555570;
      line-height: 1.8;
    }

    .footer-divider {
      width: 50px;
      height: 2px;
      background: linear-gradient(90deg, #9c27b0, #FF6B35);
      margin: 12px auto;
      border-radius: 2px;
    }
  </style>
</head>
<body>
  <div class="wrapper">

    <!-- ═══ Header ═══ -->
    <div class="header">
      <img src="https://res.cloudinary.com/dunkjkbjx/image/upload/v1776227164/sellora/branding/sellora_logo.jpg" alt="Sellora Logo" class="logo-img" />
      <p class="header-tagline">Account Security</p>
    </div>

    <!-- ═══ Shield Section ═══ -->
    <div class="shield-section">
      <div class="shield-icon">🛡️</div>
      <p class="shield-title">Password Reset Request</p>
    </div>

    <!-- ═══ Body ═══ -->
    <div class="body">

      <!-- Greeting -->
      <p class="greeting">Hi <span><%= name %></span>,</p>
      <p class="sub-text">
        We received a request to reset the password for your
        <span class="role-badge"><%= role %></span> account.<br/><br/>
        Use the secure OTP code below to set your new password. If you didn't make this request, you can safely ignore this email.
      </p>

      <!-- OTP Container -->
      <div class="otp-container">
        <p class="otp-label">🔑 Password Reset Code</p>
        <div class="otp-digits">
          <table>
            <tr>
              <% const otpStr = String(otp); %>
              <% for(let i = 0; i < otpStr.length; i++) { %>
                <td class="otp-digit"><%= otpStr[i] %></td>
              <% } %>
            </tr>
          </table>
        </div>
        <p class="otp-expiry">⏱️ This code expires in <strong>10 minutes</strong></p>
      </div>

      <!-- Steps Section -->
      <div class="steps">
        <p class="steps-title">📋 How to reset your password</p>

        <div class="step-row">
          <table>
            <tr>
              <td class="step-number-cell">1</td>
              <td class="step-text-cell">Enter the OTP code shown above</td>
            </tr>
          </table>
        </div>

        <div class="step-row">
          <table>
            <tr>
              <td class="step-number-cell">2</td>
              <td class="step-text-cell">Create a strong new password</td>
            </tr>
          </table>
        </div>

        <div class="step-row">
          <table>
            <tr>
              <td class="step-number-cell">3</td>
              <td class="step-text-cell">Confirm & you're all set! 🎉</td>
            </tr>
          </table>
        </div>
      </div>

      <!-- Security Warning -->
      <div class="security-box">
        <p class="security-title">⚠️ Important Security Warning</p>
        <p>
          If you <strong>did not request</strong> a password reset, please ignore this email immediately.
          Your account and current password remain <strong>safe and secure</strong>.
          Never share this code with anyone — the Sellora team will never ask for it.
        </p>
      </div>

    </div>

    <!-- ═══ Footer ═══ -->
    <div class="footer">
      <p class="footer-brand">
        <span class="purple">Sell</span><span class="orange">ora</span>
      </p>
      <div class="footer-divider"></div>
      <p>
        This is an automated security email from Sellora.<br/>
        Please do not reply to this email.<br/>
        &copy; <%= new Date().getFullYear() %> Sellora. All rights reserved.
      </p>
    </div>

  </div>
</body>
</html>
